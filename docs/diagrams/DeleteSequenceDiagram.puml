@startuml
!include style.puml
hide empty members
skinparam ArrowFontStyle plain
participant ":LogicManager" as logic LOGIC_COLOR
participant ":AddressBookParser" as parser LOGIC_COLOR
participant ":DeleteCommandParser" as deleteParser LOGIC_COLOR
participant "d:DeleteCommand" as command LOGIC_COLOR
participant "m:Model" as model MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR
[-> logic : execute("delete 1")
activate logic
logic -> parser : parseCommand("delete 1")
activate parser
create deleteParser
parser -> deleteParser : <<create>>
parser -> deleteParser : parse(" 1")
activate deleteParser
create command
deleteParser -> command : <<create>>
deleteParser --> parser : d
deactivate deleteParser
destroy deleteParser
parser --> logic : d
deactivate parser
logic -> model : getAddressBook()
model --> logic : records
note over logic : Copy records before execution.
logic -> command : execute(m)
activate command
command -> model : getFilteredApplicantList()
model --> command : applicants
note over command : Validate index; select applicant p.
command -> model : getApplication(p)
model --> command : optional application
command -> model : deleteApplicant(p)
model --> command
note over command
  Create deleted-applicant result r
  with former details and any application warning.
end note
command --> logic : r
deactivate command
logic -> model : rememberStateForUndo(previousRecords)
logic -> model : getAddressBook()
model --> logic : updated records
logic -> storage : saveAddressBook(updatedRecords)
storage --> logic
[<-- logic : r
deactivate logic
@enduml
