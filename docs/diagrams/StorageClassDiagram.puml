@startuml
!include style.puml
hide empty members
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR
interface Storage <<interface>>
class StorageManager
class JsonUserPrefsStorage
class JsonAddressBookStorage
class JsonSerializableAddressBook
class JsonAdaptedApplicant
class JsonAdaptedApplication
class JsonAdaptedJob
StorageManager ..|> Storage
StorageManager --> "1" JsonUserPrefsStorage
StorageManager --> "1" JsonAddressBookStorage
JsonAddressBookStorage ..> JsonSerializableAddressBook : reads / writes
JsonSerializableAddressBook --> "*" JsonAdaptedApplicant
JsonSerializableAddressBook --> "*" JsonAdaptedApplication
JsonSerializableAddressBook --> "*" JsonAdaptedJob
JsonAdaptedApplication --> "1" JsonAdaptedJob
@enduml
