@startuml
!include style.puml
hide empty members
skinparam ArrowFontStyle plain
actor User as user
participant ":UI" as ui UI_COLOR
participant ":Logic" as logic LOGIC_COLOR
participant ":Model" as model MODEL_COLOR
participant ":Storage" as storage STORAGE_COLOR
user -> ui : "delete 1"
ui -> logic : execute("delete 1")
activate logic
logic -> model : getAddressBook()
model --> logic : records
note over logic
  Copy records; execute deletion.
  Parsing, selection, and validation are omitted.
end note
logic -> model : deleteApplicant(p)
model --> logic
logic -> model : rememberStateForUndo(previousRecords)
logic -> model : getAddressBook()
model --> logic : updated records
logic -> storage : saveAddressBook(updatedRecords)
storage --> logic
logic --> ui : command result
deactivate logic
ui --> user : Updated list and deleted applicant details
@enduml
