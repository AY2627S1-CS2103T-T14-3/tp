@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

AddressBook *-down-> "1" UniquePersonList
AddressBook *-right-> "1" UniqueJobList
AddressBook *-down-> "1" UniqueApplicationList

UniqueJobList -down-> "*" Job
UniquePersonList -right-> "*" Person
UniqueApplicationList -right-> "*" Application


Person *--> Name
Person *--> Phone
Person *--> Email

Application -right-> "1" Job
Application --> "1" Person
@enduml
