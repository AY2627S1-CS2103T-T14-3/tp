@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

AddressBook *-down-> "1" UniqueApplicantList
AddressBook *-right-> "1" UniqueJobList
AddressBook *-down-> "1" UniqueApplicationList

UniqueJobList -down-> "*" Job
UniqueApplicantList -right-> "*" Applicant
UniqueApplicationList -right-> "*" Application


Applicant *--> Name
Applicant *--> Phone
Applicant *--> Email

Application -right-> "1" Job
Application --> "1" Person
@enduml
