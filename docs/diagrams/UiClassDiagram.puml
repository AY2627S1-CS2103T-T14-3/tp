@startuml
!include style.puml
hide empty members
left to right direction
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
interface Ui <<interface>>
class UiManager
class MainWindow
class CommandBox
class ResultDisplay
class StatusBarFooter
class HelpWindow
class ApplicantListPanel
class ApplicationListPanel
class JobListPanel
class ApplicantDetailPanel
class JobDetailPanel
interface Logic <<interface>> LOGIC_COLOR
UiManager ..|> Ui
UiManager --> "1" MainWindow
UiManager --> "1" Logic
MainWindow --> "1" Logic
MainWindow *--> "1" CommandBox
MainWindow *--> "1" ResultDisplay
MainWindow *--> "1" StatusBarFooter
MainWindow *--> "1" HelpWindow
MainWindow *--> "1" ApplicantListPanel
MainWindow *--> "1" ApplicationListPanel
MainWindow *--> "1" JobListPanel
MainWindow *--> "1" ApplicantDetailPanel
MainWindow *--> "1" JobDetailPanel
note bottom of MainWindow
  Swaps list and detail panels
  for the selected view.
end note
@enduml
