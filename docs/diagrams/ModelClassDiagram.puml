@startuml
!include style.puml
hide empty members
left to right direction
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR
interface Model <<interface>>
interface ReadOnlyAddressBook <<interface>>
interface ReadOnlyUserPrefs <<interface>>
class ModelManager
class AddressBook
class UserPrefs
class UniqueApplicantList
class UniqueJobList
class UniqueApplicationList
class Applicant
class Application
class Job
class Name
class Phone
class Email
ModelManager ..|> Model
AddressBook ..|> ReadOnlyAddressBook
UserPrefs ..|> ReadOnlyUserPrefs
ModelManager --> "1" AddressBook : current records
ModelManager --> "1" UserPrefs
ModelManager --> "0..10" ReadOnlyAddressBook : previous states
ModelManager --> "*" Applicant : filtered
ModelManager --> "*" Job : filtered
AddressBook *--> "1" UniqueApplicantList
AddressBook *--> "1" UniqueJobList
AddressBook *--> "1" UniqueApplicationList
UniqueApplicantList --> "*" Applicant
UniqueJobList --> "*" Job
UniqueApplicationList --> "*" Application
Application --> "1" Applicant
Application --> "1" Job
Applicant *--> "1" Name
Applicant *--> "1" Phone
Applicant *--> "1" Email
@enduml
